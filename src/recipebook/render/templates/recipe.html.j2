<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ recipe.title }}</title>
<link rel="stylesheet" href="recipe.css">
<style>
  {# Page geometry is the same for every binding except how the side margins are split. #}
  @page { size: A5; margin: 12mm {{ binding.outer_mm }}mm 16mm {{ binding.inner_mm }}mm; }
  @page :left  { margin-left: {{ binding.outer_mm }}mm; margin-right: {{ binding.inner_mm }}mm; }
  @page :right { margin-left: {{ binding.inner_mm }}mm; margin-right: {{ binding.outer_mm }}mm; }
  {% set footer_text %}font-family: "Label"; font-size: 6.8pt; letter-spacing: 0.02em; color: var(--soft); vertical-align: top; padding-top: 3.5mm;{% endset %}
  {% set footer_number %}font-family: "Label"; font-weight: 500; font-size: 7.5pt; color: var(--accent); vertical-align: top; padding-top: 3.5mm;{% endset %}
  {% if page_numbers %}
  @page recipe:left  { @bottom-left  { content: counter(page); {{ footer_number }} }
                       @bottom-right { content: string(source); {{ footer_text }} } }
  @page recipe:right { @bottom-right { content: counter(page); {{ footer_number }} }
                       @bottom-left  { content: string(source); {{ footer_text }} } }
  {% else %}
  @page recipe { @bottom-left { content: string(source); {{ footer_text }} } }
  {% endif %}
  html { font-size: {{ body_pt }}pt; }
</style>
</head>
<body>
<section class="recipe {{ 'spread' if layout != 'page' }} {{ 'flow' if layout == 'flow' }}">
  <p class="source">{{ recipe.source.credit() }}</p>
  <div class="topline">
    <span class="category">{{ recipe.category }}</span>
    {% if recipe.id %}<span class="rid">No. {{ recipe.id }}</span>{% endif %}
  </div>
  <h1 class="title">{{ recipe.title }}</h1>
  {% if recipe.headnote %}<p class="headnote">{{ recipe.headnote }}</p>{% endif %}
  {% if meta %}
  <div class="meta">
    {% for label, value in meta %}<div><span class="k">{{ label }}</span><span class="v">{{ value }}</span></div>{% endfor %}
  </div>
  {% endif %}

  {% macro ingredients() %}
    <h2 class="label">Ingredients</h2>
    <div class="groups">
    {% for group in recipe.ingredient_groups %}
      <div class="group">
        {% if group.name %}<h3 class="group-name">{{ group.name }}</h3>{% endif %}
        <ul class="ing">{% for item in group.items %}<li>{{ item.text }}</li>{% endfor %}</ul>
      </div>
    {% endfor %}
    </div>
  {% endmacro %}

  {% macro directions() %}
    <h2 class="label">Directions</h2>
    <ol class="steps">
    {% for step in recipe.steps %}<li>{% if step.lead %}<strong>{{ step.lead }}:</strong> {% endif %}{{ step.text }}</li>{% endfor %}
    </ol>
  {% endmacro %}

  {% macro note() %}
    {% if recipe.note %}<aside class="note"><p><span class="runin">Cook’s Note</span>{{ recipe.note }}</p></aside>{% endif %}
  {% endmacro %}

  {% if layout == 'page' %}
    <div class="cols">
      <div class="ingredients">{{ ingredients() }}</div>
      <div class="directions">{{ directions() }}</div>
    </div>
    {{ note() }}
  {% else %}
    <div class="ingredients">{{ ingredients() }}</div>
    <div class="directions-page">
      {{ directions() }}
      {{ note() }}
    </div>
  {% endif %}
</section>
</body>
</html>
